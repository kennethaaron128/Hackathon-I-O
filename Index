<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sleep Quality Predictor & Explorer</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#E8EDF5;--ink:#16213A;--muted:#5B6783;--line:#CBD3E1;--moon:#F2B84B;--bar:#3D5A9E;--card-bg:#fff}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 "Bricolage Grotesque",system-ui,sans-serif}
main{max-width:980px;margin:0 auto;padding:32px 20px 48px}
h1{font-size:clamp(2rem,5vw,3.2rem);line-height:1.05;margin:0 0 8px;font-weight:800;letter-spacing:-.02em}
.sub{color:var(--muted);margin:0 0 28px;max-width:60ch}
.grid{display:grid;grid-template-columns:1.1fr 1.2fr;gap:20px}
@media(max-width:760px){.grid{grid-template-columns:1fr}}
.card{background:var(--card-bg);border:1px solid var(--line);border-radius:16px;padding:24px;box-shadow:0 4px 12px rgba(22,33,58,0.04)}
label{display:block;font-weight:600;margin:0 0 14px;font-size:0.95rem}
input,select{display:block;width:100%;margin-top:6px;padding:10px 12px;font:inherit;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:8px}
input:focus-visible,select:focus-visible{outline:3px solid var(--bar);outline-offset:1px}
.score-box{display:flex;align-items:baseline;gap:8px}
.score{font-size:5rem;font-weight:800;line-height:1}
.score small{font-size:1.5rem;color:var(--muted);font-weight:400}
.dots{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 24px}
.dots span{width:28px;height:28px;border-radius:50%;background:var(--line);transition:background .25s}
.dots span.on{background:var(--moon)}
h2{font-size:1rem;margin:0 0 10px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.row{display:grid;grid-template-columns:30px 1fr 45px;gap:10px;align-items:center;margin:6px 0;font-size:.9rem}
.row div{height:12px;background:#EEF1F7;border-radius:4px;overflow:hidden}
.row i{display:block;height:100%;background:var(--bar);transition:width .25s;width:0%}
.row b{text-align:right;font-weight:600}
.note{color:var(--muted);font-size:0.85rem;margin:20px 0 0;border-top:1px solid var(--line);padding-top:14px}
</style>
</head>
<body>
<main>
  <h1>Sleep Quality Predictor</h1>
  <p class="sub">Explore how occupation, gender, age, and lifestyle factors influence estimated sleep quality based on the Sleep Health & Lifestyle Dataset.</p>
  
  <div class="grid">
    <!-- INPUT FORM -->
    <form class="card" id="f">
      <label>Occupation
        <select name="occupation" id="occ">
          {% for o in occupations %}
          <option value="{{ o }}">{{ o }}</option>
          {% endfor %}
        </select>
      </label>

      <label>Gender
        <select name="gender" id="gen">
          {% for g in genders %}
          <option value="{{ g }}">{{ g }}</option>
          {% endfor %}
        </select>
      </label>

      <label>Age
        <input type="number" name="age" id="age" value="35" min="18" max="75">
      </label>

      <label>Sleep Duration (hours)
        <input type="number" name="duration" id="dur" value="7.2" min="3" max="12" step="0.1">
      </label>

      <label>Daily Steps
        <input type="number" name="steps" id="steps" value="7500" min="1000" max="20000" step="500">
      </label>

      <label>Sleep Disorder
        <select name="disorder" id="dis">
          {% for d in disorders %}
          <option value="{{ d }}">{{ d }}</option>
          {% endfor %}
        </select>
      </label>
    </form>

    <!-- RESULTS PANEL -->
    <section class="card" aria-live="polite">
      <h2>Estimated Sleep Score</h2>
      <div class="score-box">
        <div class="score"><span id="score">7.5</span><small>/ 10</small></div>
      </div>
      <div class="dots" id="dots"></div>
      
      <h2>Probability Breakdown</h2>
      <div id="bars"></div>
      
      <p class="note"><b>Dataset Insight:</b> Notice how sleep duration and disorders like Insomnia influence the final score.</p>
    </section>
  </div>
</main>

<script>
const form = document.getElementById('f');
const dotsContainer = document.getElementById('dots');
const scoreEl = document.getElementById('score');
const barsEl = document.getElementById('bars');

// Create 10 dots for visual rating
for (let i = 0; i < 10; i++) {
  dotsContainer.appendChild(document.createElement('span'));
}

async function calculatePrediction() {
  const formData = new FormData(form);
  const data = Object.fromEntries(formData);

  try {
    const response = await fetch('/predict', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    
    if (!response.ok) return;
    const result = await response.json();
    let roundedScore = result.prediction;
    scoreEl.textContent = roundedScore;

    // Update dots
    const activeDots = Math.round(roundedScore);
    [...dotsContainer.children].forEach((dot, index) => {
      dot.classList.toggle('on', index < activeDots);
    });

    // Generate probability distribution across ratings
    let probs = {};
    for (let i = 5; i <= 10; i++) {
      let diff = Math.abs(i - roundedScore);
      let prob = Math.max(0.02, 1 - (diff * 0.5));
      probs[i] = prob;
    }
    let total = Object.values(probs).reduce((a, b) => a + b, 0);
    Object.keys(probs).forEach(k => probs[k] = probs[k] / total);

    // Render probability bars
    barsEl.innerHTML = Object.entries(probs).map(([rating, p]) => `
      <div class="row">
        <span>${rating}</span>
        <div><i style="width: ${Math.round(p * 100)}%"></i></div>
        <b>${Math.round(p * 100)}%</b>
      </div>
    `).join('');
  } catch (err) {
    console.error("Prediction error:", err);
  }
}

// Recalculate on any input change
form.addEventListener('input', calculatePrediction);
calculatePrediction();
</script>
</body>
</html>
